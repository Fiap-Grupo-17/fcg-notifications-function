{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    },
    "logLevel": {
      "default": "Information",
      "FCG.Notifications.Functions": "Information"
    }
  },
  "extensions": {
    "rabbitMQ": {
      "prefetchCount": 1
    }
  }
}
